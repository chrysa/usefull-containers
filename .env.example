# Demo mode — explore the app on fixture data, no real DB or credentials.
# Off by default; NEVER enable in production.
#
# Backend: read endpoints serve fixtures and /api/v1/health reports the flag,
# which the frontend banner polls.
DEMO_MODE=false
#
# Frontend (build-time): forces the amber "DEMO" banner on even without a
# backend reporting demo mode. Keep in sync with DEMO_MODE for a full demo.
VITE_DEMO_MODE=false

# Assistant LLM (L10) — natural-language Q&A via the chrysa ai-aggregator gateway.
# Leave AI_AGGREGATOR_URL empty to disable the LLM and keep the deterministic
# rule-based assistant (fully offline). Set it to enable grounded NL answers.
AI_AGGREGATOR_URL=
AI_AGGREGATOR_API_KEY=
# Optional: force a specific model; empty lets the gateway pick the best provider.
ASSISTANT_MODEL=
ASSISTANT_MAX_TOKENS=600
ASSISTANT_TEMPERATURE=0.3
ASSISTANT_TIMEOUT_SECONDS=20
