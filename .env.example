# Demo mode — explore the app on fixture data, no real DB or credentials.
# Off by default; NEVER enable in production.
#
# Backend: read endpoints serve fixtures and /api/v1/health reports the flag,
# which the frontend banner polls.
DEMO_MODE=false
#
# Frontend (build-time): forces the amber "DEMO" banner on even without a
# backend reporting demo mode. Keep in sync with DEMO_MODE for a full demo.
VITE_DEMO_MODE=false
