{
  "autoCompact": true,
  "autoCompactThreshold": 0.85,
  "effortLevel": "medium",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "notify-send 'Claude Code' 'En attente de ton input' 2>/dev/null || true",
            "name": "notify-user-input",
            "timeout": 3000,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/verifiable-thresholds.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "name": "verifiable-thresholds",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "name": "dockerfile-build-check",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/dockerfile-build-check.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "timeout": 15000
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "name": "compose-validate",
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/compose-validate.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "timeout": 15000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scanner.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "name": "secret-scanner",
            "timeout": 10000,
            "type": "command"
          },
          {
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/circuit-breaker.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "name": "circuit-breaker",
            "timeout": 5000,
            "type": "command"
          },
          {
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-no-env-files.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "name": "check-no-env-files",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "sh -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/frustration-detection.cjs\"; [ ! -f \"$f\" ] || node \"$f\"'",
            "name": "frustration-detection",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "python3 .claude/ape/ape_hook.py --spec .claude/ape/ape-transform-v2.md",
            "type": "command"
          }
        ]
      }
    ]
  }
}
